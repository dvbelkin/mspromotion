---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const { title, description, image = "/uploads/og-default.jpg", type = "website", noindex = false } = Astro.props;
const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ?? new URL("https://www.ms-promotion.ru");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image, siteUrl).toString();
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";
const ga4MeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID?.trim() || "G-TS7GW8GZSG";
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "MS Promotion",
  url: new URL("/", siteUrl).toString(),
  logo: new URL("/uploads/logo-blue.png", siteUrl).toString(),
  email: "promotion@mediasoft.ru",
  telephone: "+7-903-906-67-87",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Мичурина 10/1, офис 315Б",
    addressLocality: "Новосибирск",
    addressCountry: "RU"
  }
};
---

<!doctype html>
<html lang="ru" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#070b16" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/uploads/logo-blue.png" />
    <link rel="apple-touch-icon" href="/uploads/logo-blue.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="MS Promotion" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script is:inline>
      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
      m[i].l=1*new Date();
      for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
      k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
      (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

      ym(47108043, "init", {
          clickmap:true,
          trackLinks:true,
          accurateTrackBounce:true
      });
    </script>
    {ga4MeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4MeasurementId}`}></script>
        <script is:inline define:vars={{ ga4MeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag("js", new Date());
          gtag("config", ga4MeasurementId);
        </script>
      </>
    )}
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
  </head>
  <body>
    <noscript>
      <div><img src="https://mc.yandex.ru/watch/47108043" style="position:absolute; left:-9999px;" alt="" /></div>
    </noscript>
    <a href="#main" class="focus-outline sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-accent focus:px-3 focus:py-2 focus:text-white">
      Перейти к контенту
    </a>
    <Header currentPath={currentPath} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
