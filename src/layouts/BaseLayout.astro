---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { toModernImagePath } from "@/lib/images";
import { SITE_URL } from "@/lib/site";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const { title, description, image = "/uploads/og-default.webp", type = "website", noindex = false } = Astro.props;
const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ?? new URL(SITE_URL);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(toModernImagePath(image), siteUrl).toString();
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";
const ga4MeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID?.trim() || "G-TS7GW8GZSG";
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "MS Promotion",
  url: new URL("/", siteUrl).toString(),
  logo: new URL("/uploads/logo-blue.webp", siteUrl).toString(),
  email: "promotion@mediasoft.ru",
  telephone: "+7-903-906-67-87",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Мичурина 10/1, офис 315Б",
    addressLocality: "Новосибирск",
    addressCountry: "RU"
  }
};
---

<!doctype html>
<html lang="ru" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#070b16" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/webp" href="/uploads/logo-blue.webp" />
    <link rel="apple-touch-icon" href="/uploads/logo-blue.webp" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap" rel="stylesheet" />
    </noscript>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="MS Promotion" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script is:inline define:vars={{ ga4MeasurementId }}>
      (function () {
        var hasLoadedMetrics = false;
        var yandexTagUrl = "https://mc.yandex.ru/metrika/tag.js";
        var yandexCounterId = 47108043;
        var triggerEvents = ["scroll", "mousemove", "touchstart", "keydown"];

        function appendScript(src, onload) {
          if (document.querySelector('script[src="' + src + '"]')) return;
          var script = document.createElement("script");
          script.async = true;
          script.src = src;
          if (onload) script.onload = onload;
          document.head.appendChild(script);
        }

        function cleanupTriggers() {
          triggerEvents.forEach(function (eventName) {
            window.removeEventListener(eventName, loadMetrics, { passive: true });
          });
          window.removeEventListener("load", scheduleIdleLoad);
        }

        function initYandex() {
          window.ym =
            window.ym ||
            function () {
              (window.ym.a = window.ym.a || []).push(arguments);
            };
          window.ym.l = window.ym.l || Date.now();

          appendScript(yandexTagUrl, function () {
            window.ym(yandexCounterId, "init", {
              clickmap: true,
              trackLinks: true,
              accurateTrackBounce: true
            });
          });
        }

        function initGoogle() {
          if (!ga4MeasurementId) return;

          window.dataLayer = window.dataLayer || [];
          window.gtag =
            window.gtag ||
            function () {
              window.dataLayer.push(arguments);
            };

          appendScript("https://www.googletagmanager.com/gtag/js?id=" + ga4MeasurementId, function () {
            window.gtag("js", new Date());
            window.gtag("config", ga4MeasurementId);
          });
        }

        function loadMetrics() {
          if (hasLoadedMetrics) return;
          hasLoadedMetrics = true;
          cleanupTriggers();
          initYandex();
          initGoogle();
        }

        function scheduleIdleLoad() {
          if ("requestIdleCallback" in window) {
            window.requestIdleCallback(loadMetrics, { timeout: 4000 });
            return;
          }

          window.setTimeout(loadMetrics, 4000);
        }

        triggerEvents.forEach(function (eventName) {
          window.addEventListener(eventName, loadMetrics, { passive: true, once: true });
        });
        window.addEventListener("load", scheduleIdleLoad, { once: true });
      })();
    </script>
    <script is:inline>
      requestAnimationFrame(function () {
        document.documentElement.classList.add("fx-ready");
      });
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
  </head>
  <body>
    <noscript>
      <div><img src="https://mc.yandex.ru/watch/47108043" style="position:absolute; left:-9999px;" alt="" /></div>
    </noscript>
    <a href="#main" class="focus-outline sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-accent focus:px-3 focus:py-2 focus:text-white">
      Перейти к контенту
    </a>
    <Header currentPath={currentPath} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
