---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentGallery from "@/components/ContentGallery.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { contentSlug } from "@/lib/content-slug";
import { resolveSeo } from "@/lib/seo";

export async function getStaticPaths() {
  const promos = await getCollection("promos", ({ data }) => data.status === "published");
  return promos.map((promo) => ({ params: { slug: contentSlug(promo) }, props: { promo } }));
}

const { promo } = Astro.props as { promo: CollectionEntry<"promos"> };
const { Content } = await render(promo);
const seo = resolveSeo(promo.data);
---

<BaseLayout title={seo.title} description={seo.description} image={seo.image} type="article">
  <article class="section-wrap mt-12">
    <a href="/promos" class="focus-outline text-sm text-accent2">← К списку акций</a>
    <h1 class="mt-3 font-display text-4xl font-semibold md:text-5xl">{promo.data.title}</h1>
    {promo.data.discountText && <p class="mt-3 text-sm text-muted">Условия: {promo.data.discountText}</p>}

    <img src={promo.data.coverImage} alt={promo.data.title} class="mt-6 h-[380px] w-full rounded-2xl object-cover" width="1280" height="760" />

    <ContentGallery items={promo.data.gallery} title={promo.data.title} />

    <div class="prose mt-8 max-w-none prose-headings:font-display prose-headings:text-text prose-p:text-muted prose-li:text-muted prose-strong:text-text prose-a:text-accent2">
      <Content />
    </div>

    <a href={promo.data.ctaUrl} class="focus-outline mt-8 inline-flex rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white transition hover:bg-accent/85">
      Обсудить акцию
    </a>
  </article>
</BaseLayout>
