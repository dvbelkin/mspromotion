---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { formatDateRange } from "@/lib/content";

export async function getStaticPaths() {
  const events = await getCollection("events", ({ data }) => data.status === "published");
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

const { event } = Astro.props as { event: CollectionEntry<"events"> };
const { Content } = await render(event);
---

<BaseLayout title={`${event.data.title} | MS Promotion`} description={event.data.descriptionShort} image={event.data.coverImage} type="article" noindex={true}>
  <article class="section-wrap mt-12">
    <a href="/events" class="focus-outline text-sm text-accent2">← К списку событий</a>
    <h1 class="mt-3 font-display text-4xl font-semibold md:text-5xl">{event.data.title}</h1>
    <p class="mt-3 text-sm text-muted">
      {formatDateRange(event.data.dateStart, event.data.dateEnd)}
      {event.data.city ? ` · ${event.data.city}` : ""}
      {event.data.place ? ` · ${event.data.place}` : ""}
    </p>

    <img src={event.data.coverImage} alt={event.data.title} class="mt-6 h-[380px] w-full rounded-2xl object-cover" width="1280" height="760" />

    <div class="prose mt-8 max-w-none prose-headings:font-display prose-headings:text-text prose-p:text-muted prose-li:text-muted prose-strong:text-text prose-a:text-accent2">
      <Content />
    </div>

    {event.data.ctaUrl && (
      <a href={event.data.ctaUrl} class="focus-outline mt-8 inline-flex rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white transition hover:bg-accent/85">
        {event.data.ctaText || "Оставить заявку"}
      </a>
    )}
  </article>
</BaseLayout>
