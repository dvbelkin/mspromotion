---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import Metrics from "@/components/Metrics.astro";
import LogoStrip from "@/components/LogoStrip.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getPublishedProjects } from "@/lib/content";

const projects = await getPublishedProjects();
const projectsToShow = projects.slice(0, 6);
---

<BaseLayout
  title="MS Promotion - маркетинговые проекты и промо-решения"
  description="MS Promotion: кейсы и услуги агентства. "
>
  <section class="pt-4 md:pt-6">
    <Hero />
    <Metrics />
    <LogoStrip />
  </section>

  <section class="section-wrap mt-20">
    <div class="section-shell">
      <SectionTitle title="Проекты и кейсы" description="Ключевые реализованные кампании: ритейл-активации, бренд-проекты и деловые форматы." />
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {projectsToShow.map((project) => <ProjectCard project={project} />)}
      </div>
      <a href="/projects" class="focus-outline mt-7 inline-flex rounded-full border border-line bg-surface-elevated px-5 py-2 text-sm font-semibold text-text transition hover:border-accent2 hover:text-accent2">
        Перейти к кейсам
      </a>
    </div>
  </section>
</BaseLayout>
