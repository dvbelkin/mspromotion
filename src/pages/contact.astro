---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedPage } from "@/lib/content";
import { render } from "astro:content";

const page = await getPublishedPage("contact");
if (!page) {
  throw new Error("Page contact not found");
}

const { Content } = await render(page);
---

<BaseLayout title="Контакты | MS Promotion" description={page.data.descriptionShort}>
  <article class="section-wrap mt-12">
    <h1 class="font-display text-4xl font-semibold md:text-5xl">{page.data.title}</h1>
    <div class="prose mt-8 max-w-none prose-headings:font-display prose-headings:text-text prose-p:text-muted prose-li:text-muted prose-strong:text-text prose-a:text-accent2">
      <Content />
    </div>
  </article>
</BaseLayout>
