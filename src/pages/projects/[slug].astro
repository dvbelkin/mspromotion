---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentGallery from "@/components/ContentGallery.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.status === "published");
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
---

<BaseLayout title={`${project.data.title} | MS Promotion`} description={project.data.descriptionShort} image={project.data.coverImage} type="article">
  <article class="section-wrap mt-12">
    <a href="/projects" class="focus-outline text-sm text-accent2">← К списку проектов</a>
    <h1 class="mt-3 font-display text-4xl font-semibold md:text-5xl">{project.data.title}</h1>

    <ContentGallery items={project.data.gallery} title={project.data.title} />
  </article>
</BaseLayout>
