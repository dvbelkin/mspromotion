---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.status === "published");
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const galleryItems = project.data.gallery.map((entry, index) => {
  if (typeof entry === "string") {
    return {
      image: entry,
      caption: `${project.data.title}: кадр ${index + 1}`
    };
  }

  return {
    image: entry.image,
    caption: entry.caption || `${project.data.title}: кадр ${index + 1}`
  };
});
---

<BaseLayout title={`${project.data.title} | MS Promotion`} description={project.data.descriptionShort} image={project.data.coverImage} type="article">
  <article class="section-wrap mt-12">
    <a href="/projects" class="focus-outline text-sm text-accent2">← К списку проектов</a>
    <h1 class="mt-3 font-display text-4xl font-semibold md:text-5xl">{project.data.title}</h1>

    {galleryItems.length > 0 && (
      <section class="mt-8">
        <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
          {galleryItems.map((item) => (
            <figure class="card-surface overflow-hidden rounded-2xl p-3">
              <img src={item.image} alt={item.caption} class="h-52 w-full rounded-xl object-cover" loading="lazy" width="560" height="360" />
              <figcaption class="mt-3 text-sm text-muted">{item.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
