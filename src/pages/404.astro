---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404 | MS Promotion" description="Страница не найдена." noindex={true}>
  <section class="section-wrap mt-20 text-center">
    <p class="eyebrow">Ошибка 404</p>
    <h1 class="mt-2 font-display text-5xl font-semibold">Страница не найдена</h1>
    <p class="mt-4 text-muted">Проверьте адрес или вернитесь на главную.</p>
    <a href="/" class="focus-outline mt-8 inline-flex rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white">На главную</a>
  </section>
</BaseLayout>
