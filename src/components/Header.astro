---
interface NavItem {
  href: string;
  label: string;
}

const { currentPath = "/" } = Astro.props;

const navItems: NavItem[] = [
  { href: "/", label: "Главная" },
  { href: "/events", label: "События" },
  { href: "/promos", label: "Акции" },
  { href: "/projects", label: "Проекты" },
  { href: "/services", label: "Услуги" },
  { href: "/history", label: "История" }
];

const isActive = (href: string) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-surface/85 backdrop-blur-lg">
  <div class="section-wrap flex min-h-[78px] items-center justify-between gap-4">
    <a href="/" class="focus-outline inline-flex items-center gap-3 font-display text-lg font-semibold tracking-wide">
      <span class="inline-flex size-9 items-center justify-center rounded-full border border-line bg-surface-soft text-sm text-accent2">MS</span>
      <span>MS Promotion</span>
    </a>

    <button
      id="menu-toggle"
      class="focus-outline inline-flex h-10 w-10 items-center justify-center rounded-lg border border-line bg-surface-soft text-text md:hidden"
      aria-expanded="false"
      aria-controls="main-menu"
      type="button"
    >
      ☰
    </button>

    <nav id="main-menu" class="hidden items-center gap-1 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "focus-outline rounded-full px-4 py-2 text-sm font-medium transition",
            isActive(item.href) ? "bg-surface-soft text-text" : "text-muted hover:bg-surface-soft/60 hover:text-text"
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-2 md:flex">
      <button
        id="theme-toggle"
        class="focus-outline rounded-full border border-line bg-surface-soft px-3 py-2 text-xs font-semibold uppercase tracking-[0.12em] text-muted transition hover:text-text"
        type="button"
        aria-label="Переключить тему"
      >
        Light
      </button>
      <a href="/contact" class="focus-outline rounded-full bg-accent px-5 py-2 text-sm font-semibold text-white transition hover:bg-accent/85">
        Связаться
      </a>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-surface-soft/80 md:hidden">
    <div class="section-wrap flex flex-col py-3">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "focus-outline rounded-lg px-3 py-2 text-sm font-medium transition",
            isActive(item.href) ? "bg-surface text-text" : "text-muted hover:bg-surface/70 hover:text-text"
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      <div class="mt-2 flex items-center gap-2">
        <button
          id="theme-toggle-mobile"
          class="focus-outline flex-1 rounded-full border border-line bg-surface px-3 py-2 text-xs font-semibold uppercase tracking-[0.12em] text-muted"
          type="button"
        >
          Light
        </button>
        <a href="/contact" class="focus-outline rounded-full bg-accent px-4 py-2 text-sm font-semibold text-white">Связаться</a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const html = document.documentElement;
  const storageKey = "msp-theme";

  const applyTheme = (theme) => {
    html.dataset.theme = theme;
    const label = theme === "dark" ? "Light" : "Dark";
    document.querySelectorAll("#theme-toggle, #theme-toggle-mobile").forEach((button) => {
      button.textContent = label;
    });
  };

  const storedTheme = localStorage.getItem(storageKey);
  applyTheme(storedTheme === "light" ? "light" : "dark");

  const onToggleTheme = () => {
    const nextTheme = html.dataset.theme === "dark" ? "light" : "dark";
    localStorage.setItem(storageKey, nextTheme);
    applyTheme(nextTheme);
  };

  document.querySelectorAll("#theme-toggle, #theme-toggle-mobile").forEach((button) => {
    button?.addEventListener("click", onToggleTheme);
  });

  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  menuToggle?.addEventListener("click", () => {
    const expanded = menuToggle.getAttribute("aria-expanded") === "true";
    menuToggle.setAttribute("aria-expanded", String(!expanded));
    mobileMenu?.classList.toggle("hidden", expanded);
  });
</script>
