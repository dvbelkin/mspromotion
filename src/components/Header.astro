---
interface NavItem {
  href: string;
  label: string;
}

const { currentPath = "/" } = Astro.props;

const navItems: NavItem[] = [
  { href: "/", label: "Главная" },
  { href: "/projects", label: "Проекты" },
  { href: "/services", label: "Услуги" }
];

const isActive = (href: string) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href));
---

<header class="sticky top-0 z-50 pt-3">
  <div class="section-wrap">
    <div class="nav-shell flex min-h-[74px] items-center justify-between gap-4">
      <a href="/" class="focus-outline inline-flex items-center gap-3" aria-label="MS Promotion">
        <img src="/uploads/logo.webp" alt="Mediasoft" class="brand-logo brand-logo--dark" width="175" height="64" loading="eager" decoding="async" />
        <img src="/uploads/logo-blue.webp" alt="" aria-hidden="true" class="brand-logo brand-logo--light" width="175" height="64" loading="eager" decoding="async" />
      </a>

      <button
        id="menu-toggle"
        class="focus-outline inline-flex h-10 items-center justify-center rounded-xl border border-line bg-surface-soft px-3 text-xs font-semibold uppercase tracking-[0.15em] text-muted md:hidden"
        aria-expanded="false"
        aria-controls="main-menu"
        type="button"
      >
        Menu
      </button>

      <nav id="main-menu" class="hidden items-center gap-1 md:flex">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "focus-outline rounded-full px-4 py-2 text-sm font-medium transition",
              isActive(item.href)
                ? "bg-surface-elevated text-text shadow-[0_8px_24px_rgba(6,9,20,0.28)]"
                : "text-muted hover:bg-surface-elevated hover:text-text"
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="hidden items-center gap-2 md:flex">
        <button
          id="theme-toggle"
          class="focus-outline rounded-full border border-line bg-surface-soft px-3 py-2 text-xs font-semibold uppercase tracking-[0.12em] text-muted transition hover:text-text"
          type="button"
          aria-label="Переключить тему"
        >
          Light
        </button>
        <a href="/contact" class="focus-outline rounded-full bg-accent px-5 py-2 text-sm font-semibold text-white shadow-[0_12px_26px_rgba(95,125,255,0.35)] transition hover:bg-accent/85">
          Связаться
        </a>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="section-wrap hidden md:hidden">
    <div class="mt-2 rounded-2xl border border-line bg-surface-soft p-3">
      <div class="flex flex-col">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "focus-outline rounded-lg px-3 py-2 text-sm font-medium transition",
              isActive(item.href) ? "bg-surface text-text" : "text-muted hover:bg-surface/70 hover:text-text"
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>
      <div class="mt-3 flex items-center gap-2">
        <button
          id="theme-toggle-mobile"
          class="focus-outline flex-1 rounded-full border border-line bg-surface px-3 py-2 text-xs font-semibold uppercase tracking-[0.12em] text-muted"
          type="button"
        >
          Light
        </button>
        <a href="/contact" class="focus-outline rounded-full bg-accent px-4 py-2 text-sm font-semibold text-white">Связаться</a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const html = document.documentElement;
  const storageKey = "msp-theme";

  const applyTheme = (theme) => {
    html.dataset.theme = theme;
    const label = theme === "dark" ? "Light" : "Dark";
    document.querySelectorAll("#theme-toggle, #theme-toggle-mobile").forEach((button) => {
      button.textContent = label;
    });
  };

  const storedTheme = localStorage.getItem(storageKey);
  applyTheme(storedTheme === "light" ? "light" : "dark");

  const onToggleTheme = () => {
    const nextTheme = html.dataset.theme === "dark" ? "light" : "dark";
    localStorage.setItem(storageKey, nextTheme);
    applyTheme(nextTheme);
  };

  document.querySelectorAll("#theme-toggle, #theme-toggle-mobile").forEach((button) => {
    button?.addEventListener("click", onToggleTheme);
  });

  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  menuToggle?.addEventListener("click", () => {
    const expanded = menuToggle.getAttribute("aria-expanded") === "true";
    menuToggle.setAttribute("aria-expanded", String(!expanded));
    mobileMenu?.classList.toggle("hidden", expanded);
  });
</script>
