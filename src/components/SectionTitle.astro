---
const { title, description } = Astro.props as { title: string; description?: string };
---

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="eyebrow">MS Promotion</p>
    <h2 class="mt-2 font-display text-3xl font-semibold md:text-4xl">{title}</h2>
  </div>
  {description && <p class="max-w-2xl text-sm text-muted md:text-base">{description}</p>}
</div>
