---
import type { CollectionEntry } from "astro:content";
import { formatDateRange } from "@/lib/content";

const { event } = Astro.props as { event: CollectionEntry<"events"> };
---

<article class="card-surface group rounded-2xl p-5 shadow-soft transition hover:-translate-y-0.5 hover:border-accent2/40">
  <img
    src={event.data.coverImage}
    alt={event.data.title}
    loading="lazy"
    class="h-44 w-full rounded-xl object-cover"
    width="640"
    height="352"
  />
  <p class="mt-4 text-xs uppercase tracking-[0.14em] text-muted">
    {formatDateRange(event.data.dateStart, event.data.dateEnd)}
    {event.data.city ? ` · ${event.data.city}` : ""}
  </p>
  <h3 class="mt-2 font-display text-2xl font-semibold leading-tight">{event.data.title}</h3>
  <p class="mt-3 text-sm text-muted">{event.data.descriptionShort}</p>
  <a href={`/events/${event.slug}`} class="focus-outline mt-4 inline-flex text-sm font-semibold text-accent2 transition group-hover:translate-x-0.5">
    Подробнее →
  </a>
</article>
